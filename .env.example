# Copiar a .env y completar. Nunca subir el .env real.
DATABASE_URL=postgresql://usuario:clave@localhost/rizoma
# Cadena larga y aleatoria, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Opcional: secreto aparte para los seudónimos estables (si falta, se usa SECRET_KEY).
SEUDONIMO_SECRETO=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOWED_HOSTS=127.0.0.1,localhost
INITIAL_ADMIN_PASSWORD=
ENVIRONMENT=development
