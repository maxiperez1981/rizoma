[Unit]
Description=Revision diaria de conservacion y pedidos de privacidad de Rizoma (solo informa)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=almaapp
WorkingDirectory=/home/alma-academica
Environment=PYTHONPATH=/home/alma-academica
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 /home/alma-academica/scripts/privacidad_revision.py
